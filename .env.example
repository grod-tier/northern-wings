GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3000

# ─── Shop / checkout (Stripe) ───────────────────────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys (use a test key while developing)
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint, from the Stripe Dashboard or `stripe listen`
STRIPE_WEBHOOK_SECRET=
# Optional overrides for the Pollinator Garden Kit product
STRIPE_KIT_NAME=Pollinator Garden Starter Kit
STRIPE_KIT_PRICE_CENTS=1500
# Public URL of a product photo shown on the Stripe Checkout page (must be https://)
STRIPE_KIT_IMAGE_URL=
# Base URL used for Stripe Checkout success/cancel redirects (e.g. https://northernwings.org)
SITE_URL=http://localhost:3000

# ─── Order notification email (sent on successful checkout) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDER_NOTIFICATION_EMAIL=
